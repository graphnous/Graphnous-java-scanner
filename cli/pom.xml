<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.graphnous</groupId>
        <artifactId>graphnous-scanner</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!--
        Scans a repository from the command line, with the scan planning and
        execution the server uses. Runs each scanner in a Docker container of
        its image, published by graphnous-java-scanner and
        graphnous-typescript-scanner.
    -->
    <artifactId>cli</artifactId>

    <dependencies>
        <dependency>
            <groupId>dev.graphnous</groupId>
            <artifactId>graphnous-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.graphnous</groupId>
            <artifactId>graphnous-scanner-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.graphnous</groupId>
            <artifactId>graphnous-scanner-java</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.graphnous</groupId>
            <artifactId>graphnous-scanner-typescript</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.graphnous</groupId>
            <artifactId>graphnous-scanner-docker</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <!-- Silences the logging of docker-java; the CLI reports progress itself. -->
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>graphnous-scanner</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.graphnous.scanner.cli.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
