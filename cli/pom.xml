<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.graphnous</groupId>
        <artifactId>graphnous-scanner</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cli</artifactId>

    <properties>
        <!-- The CLI looks for its scanners in this directory next to its jar. -->
        <scanners.directory>${project.build.directory}/scanners</scanners.directory>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.graphnous</groupId>
            <artifactId>graphnous-scanner-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.graphnous</groupId>
            <artifactId>graphnous-scanner-java</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.graphnous</groupId>
            <artifactId>graphnous-scanner-typescript</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.graphnous</groupId>
            <artifactId>graphnous-scanner-docker</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <!-- Silences the logging of docker-java; the CLI reports progress itself. -->
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>graphnous-scanner</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-java-scanner</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>dev.graphnous</groupId>
                                    <artifactId>java-scanner-app</artifactId>
                                    <version>${project.version}</version>
                                    <destFileName>java-scanner.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${scanners.directory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <!--
                            scanner.js is the bundled build of graphnous-typescript-scanner in
                            this repository; build that first (npm run build) to include it.
                            Without it the build still succeeds, but the CLI refuses to start
                            unless its typescript-scanner option points to one.
                        -->
                        <id>copy-typescript-scanner</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${scanners.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../graphnous-typescript-scanner/build</directory>
                                    <includes>
                                        <include>scanner.js</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.graphnous.scanner.cli.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
